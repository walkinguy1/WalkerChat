# Direct local backend development only. All local service defaults are dev-only.
APP_ENV=development
DEBUG=false
SEED_DEMO_ACCOUNTS=false
ENABLE_TEST_ROUTES=false
# Set a unique local-only value if SEED_DEMO_ACCOUNTS=true.
DEMO_ACCOUNT_PASSWORD=
JWT_SECRET=development-only-change-this-jwt-secret
CORS_ORIGINS=["http://localhost:5173"]

# Public Supabase Auth configuration. No service-role key belongs in this file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

APP_NAME=WalkerChat API
DATABASE_URL=postgresql+asyncpg://walker:change-this-postgres-password@localhost:5432/walkerchat
REDIS_URL=redis://localhost:6379/0
WEBSOCKET_CHANNEL=walkerchat:deliveries

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_SECURE=false
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
