# Local Docker Compose development only. Do not deploy these placeholder values.
APP_ENV=development
DEBUG=false
SEED_DEMO_ACCOUNTS=false
ENABLE_TEST_ROUTES=false
# Set a unique local-only value if SEED_DEMO_ACCOUNTS=true.
DEMO_ACCOUNT_PASSWORD=
JWT_SECRET=development-only-change-this-jwt-secret
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_DB=walkerchat
POSTGRES_USER=walker
POSTGRES_PASSWORD=change-this-postgres-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password

# Compose supplies container-internal DATABASE_URL and REDIS_URL values.
DATABASE_URL=postgresql+asyncpg://walker:change-this-postgres-password@postgres:5432/walkerchat
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
# Local Compose explicitly uses MinIO. Production/staging must use supabase and
# provide the server-only SUPABASE_STORAGE_* values below.
STORAGE_BACKEND=minio
MEDIA_BUCKET=walkerchat-media
MEDIA_MAX_BYTES=8388608
# Supabase S3 credentials are server-side only; never add them to VITE_* variables.
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your-project-region
SUPABASE_STORAGE_ACCESS_KEY=your-s3-access-key
SUPABASE_STORAGE_SECRET_KEY=your-s3-secret-key
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_MEDIA_MAX_BYTES=8388608
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public Supabase Auth configuration. Do not add a service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
