# Docker Compose defaults for local development.
# Copy this file to `.env` before running `docker-compose up --build`.

POSTGRES_DB=walkerchat
POSTGRES_USER=walker
POSTGRES_PASSWORD=change-this-postgres-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password

DEBUG=True
DATABASE_URL=postgresql+asyncpg://walker:change-this-postgres-password@postgres:5432/walkerchat
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_MINIO_URL=http://localhost:9000
